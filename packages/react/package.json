    },
    "./command-menu": {
      "types": "./dist/command-menu/index.d.ts",
      "import": "./dist/command-menu/index.js",
      "require": "./dist/command-menu/index.cjs"
    },
    "./kbd": {
      "types": "./dist/kbd/index.d.ts",
      "import": "./dist/kbd/index.js",
      "require": "./dist/kbd/index.cjs"
    },
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js",
      "require": "./dist/select/index.cjs"
    },
    "./video-player": {
      "types": "./dist/video-player/index.d.ts",
      "import": "./dist/video-player/index.js",
      "require": "./dist/video-player/index.cjs"
    },
    "./combobox": {
      "types": "./dist/combobox/index.d.ts",
      "import": "./dist/combobox/index.js",
      "require": "./dist/combobox/index.cjs"
    },
    "./context-menu": {
      "types": "./dist/context-menu/index.d.ts",
